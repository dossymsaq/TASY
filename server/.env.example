# Настройки сервера «Жеткіз 750».
# Строки, начинающиеся с #, — это пояснения, их можно не трогать.

# Токен Telegram-бота от @BotFather (вида 123456789:AAE...). Никому его не показывайте.
TELEGRAM_BOT_TOKEN=

# Номера администраторов через запятую, например: 87001234567
# При первом входе через Telegram этот номер получит права администратора.
ADMIN_PHONES=

# Рабочий режим: без демо-аккаунтов и тестовых SMS-кодов. Не меняйте, если сайт открыт в интернет.
DEMO=0

# Сколько получает курьер за одну доставку, ₸
COURIER_FEE=1000

# Вход по SMS: off — выключен; mobizon — через Mobizon (нужен MOBIZON_API_KEY)
SMS_MODE=off
MOBIZON_API_KEY=

# Адрес сайта для ссылок в уведомлениях. При запуске через start-windows.bat заполняется сам.
PUBLIC_URL=
