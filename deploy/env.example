# Настройки сервера Жеткіз 750. Скопируйте в /etc/jetkiz750.env и заполните.
# Файл содержит секреты — права 600, владелец root.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
DB_FILE=/var/lib/jetkiz750/data.sqlite
PUBLIC_URL=https://jetkiz750.kz

# Режим запуска: soft — мягкий старт без договоров с банком и SMS-сервисом:
#   оплата только наличными курьеру, вход по паролю (продавцы подают заявку с паролем),
#   клиенты отслеживают посылку по ссылке без входа. Уберите строку (или full), когда подключите Freedom Pay и Mobizon.
LAUNCH_MODE=soft

# Случайная строка: openssl rand -hex 32
OTP_SECRET=

# SMS: mock — тест (сообщения видны в кабинете админа → «Уведомления»), mobizon — реальная отправка
SMS_MODE=mock
# SMS о статусах заказа: 0 — не отправлять (только код входа), 1 — отправлять тем, у кого нет приложения
SMS_STATUS=0
MOBIZON_API_KEY=
MOBIZON_FROM=

# Платежи: mock — тестовая страница оплаты (НЕ оставляйте в работе!), freedompay — Freedom Pay
PAYMENT_MODE=mock
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
FREEDOMPAY_TESTING=1

# Push-уведомления в мобильное приложение (Expo). Ключ нужен, только если в Expo включена защита push.
PUSH_MODE=expo
EXPO_ACCESS_TOKEN=
