# Настройки сервера Жеткіз 750. Скопируйте в /etc/jetkiz750.env и заполните.
# Файл содержит секреты — права 600, владелец root.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
DB_FILE=/var/lib/jetkiz750/data.sqlite
PUBLIC_URL=https://jetkiz750.kz

# Случайная строка: openssl rand -hex 32
OTP_SECRET=

# SMS: mock — тест (сообщения видны в кабинете админа → SMS), mobizon — реальная отправка
SMS_MODE=mock
MOBIZON_API_KEY=
MOBIZON_FROM=

# Платежи: mock — тестовая страница оплаты (НЕ оставляйте в работе!), freedompay — Freedom Pay
PAYMENT_MODE=mock
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
FREEDOMPAY_TESTING=1
